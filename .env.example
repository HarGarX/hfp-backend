# Application Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=hfp_dev

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
